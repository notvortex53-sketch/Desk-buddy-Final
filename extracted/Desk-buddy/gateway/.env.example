APP_NAME=Desk Buddy Gateway
ENVIRONMENT=development
DATABASE_URL=sqlite:///./desk_buddy.db
CORS_ORIGINS=https://stunning-sprite-56532f.netlify.app,http://localhost:8888,http://127.0.0.1:8888
PUBLIC_GATEWAY_URL=http://127.0.0.1:8000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
PAIRING_RATE_LIMIT_PER_HOUR=5
DEVICE_AUTH_TIMEOUT_SECONDS=10
DEVICE_HEARTBEAT_SECONDS=25
WINDOWS_REAUTHENTICATION_SECONDS=3600
ANDROID_REAUTHENTICATION_SECONDS=3600
ETHICAL_MODE_REQUIRED=true
DEVICE_TOKEN_PEPPER=replace-with-a-new-random-secret-at-least-32-characters-long
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# Phase 10: NVIDIA NIM is the default provider for chat and Ethical Mode.
# Create a key in the NVIDIA API Catalog and store it as a Render secret.
CHAT_PROVIDER=nvidia
ETHICAL_PROVIDER=nvidia
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
ETHICAL_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional: OpenRouter is retained only for the existing audio pipeline.
# NVIDIA text-chat support does not automatically replace speech input/output.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VOICE_MODEL=openai/gpt-audio-mini
VOICE_NAME=alloy
MODEL_TIMEOUT_SECONDS=60
